# ==============================================================================
# BhoomiSync Backend Environment Configuration
# ==============================================================================

# Core Application Settings
APP_NAME=BhoomiSync
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=False

# API Server Host & Port (Render sets PORT automatically)
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (Render Managed PostgreSQL)
# ------------------------------------------------------------------------------
# Render Internal Connection String (automatically set if using Blueprint):
# e.g., postgresql://bhoomi_admin:secret@dpg-xxxx-a.oregon-postgres.render.com/bhoomisync
DATABASE_URL=sqlite:///./data/bhoomisync_dev.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 2. CORS Allowed Origins (Comma-separated list or '*' for open access)
# ------------------------------------------------------------------------------
# Include your Vercel deployment URL here:
CORS_ORIGINS=https://bhoomisync-frontend.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. JWT Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=generate_a_64_char_secure_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASHING_ALGORITHM=bcrypt
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ALLOW_DEV_HEADER_AUTH=True

# ------------------------------------------------------------------------------
# 4. Cloudflare R2 Object Storage (Decoupled S3-Compatible Storage)
# ------------------------------------------------------------------------------
# To switch Cloudflare R2 accounts, simply change these 5 variables with ZERO code changes:
# 1) In Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create Token (Object Read & Write)
# 2) Copy Account ID, Access Key ID, and Secret Access Key:
STORAGE_PROVIDER=R2
R2_ACCOUNT_ID=your_cloudflare_account_id_hex
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=bhoomisync-drone-data
# R2_ENDPOINT_URL is optional - if omitted, defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://your_cloudflare_account_id_hex.r2.cloudflarestorage.com

# Processing Simulation Flag (set to True for lightweight cloud operation)
SIMULATED_PROCESSING=True

# ------------------------------------------------------------------------------
# 5. Hugging Face Cloud Inference API (Optional AI Models)
# ------------------------------------------------------------------------------
# Get your free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HF_SAM_MODEL=facebook/sam-vit-base
HF_LULC_MODEL=nvidia/segformer-b0-finetuned-ade-512-512
