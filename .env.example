# BhoomiSync Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.

# Application Settings
APP_NAME=BhoomiSync
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api

# Database Connection (PostgreSQL with PostGIS)
# Example PostgreSQL: postgresql://bhoomi_user:bhoomi_pass@localhost:5432/bhoomisync_db
# Example SQLite fallback: sqlite:///./data/bhoomisync_dev.db
DATABASE_URL=sqlite:///./data/bhoomisync_dev.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Cloud Storage Abstraction (MOCK, LOCAL, S3, GCS, AZURE)
STORAGE_PROVIDER=MOCK
STORAGE_BUCKET=bhoomisync-surveys-data
STORAGE_LOCAL_ROOT=./data

# Data Gateway Configuration (ESP32_PHONE, COMPANION_COMPUTER)
DATA_GATEWAY_TYPE=ESP32_PHONE
DATA_GATEWAY_DEVICE_ID=ESP32-PROTO-01

# Geospatial Engine
DEFAULT_CRS=EPSG:4326
PROJECTED_CRS_ZONE=EPSG:32643

# Authentication & Security Configuration (Prompt 6)
JWT_SECRET_KEY=bhoomisync-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASHING_ALGORITHM=bcrypt
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ALLOW_DEV_HEADER_AUTH=True

# Cloudflare R2 Cloud Storage (Prompt 8)
# Keep private - never expose to frontend
R2_ACCOUNT_ID=7f22adee30417f230c824c656d84ecd4
R2_ACCESS_KEY_ID=20a15c2dca4d1f67663e45acf4d9e833
R2_SECRET_ACCESS_KEY=bef22e7d11349182eb0b6c3efd3a8c62752439fc4614d97060da5c1c05d07628
R2_BUCKET_NAME=bhoomisync-drone-data
R2_ENDPOINT_URL=https://7f22adee30417f230c824c656d84ecd4.r2.cloudflarestorage.com
SIMULATED_PROCESSING=True

